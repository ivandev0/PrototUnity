#pragma kernel CSMain

struct Voxel
{
    uint id;
    float3 position;
};

AppendStructuredBuffer<Voxel> voxels;
Texture3D<float> points;
uint numPointsPerAxis;

const int isoLevel = 0;

float3 coordToWorld(int3 coord)
{
    return coord - ((numPointsPerAxis - 1.0) * 0.5f);
}

float sampleDensity(int3 coord)
{
    coord = max(0, min(coord, numPointsPerAxis));
    return points[coord];
}

bool isInsideMesh(uint3 position)
{
    for (int i = -1; i < 2; ++i)
    {
        for (int j = -1; j < 2; ++j)
        {
            for (int k = -1; k < 2; ++k)
            {
                if (i + position.x < 0 || position.x + i >= numPointsPerAxis) continue;
                if (j + position.y < 0 || position.y + j >= numPointsPerAxis) continue;
                if (k + position.z < 0 || position.z + k >= numPointsPerAxis) continue;

                if (points[position + int3(i, j, k)] > 0)
                {
                    return false;
                }
            }
        }
    }

    return true;
}

[numthreads(8,8,8)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= numPointsPerAxis || id.y >= numPointsPerAxis || id.z >= numPointsPerAxis)
    {
        return;
    }

    float density = sampleDensity(id);
    if (density > 0) return;
    
    if (isInsideMesh(id)) return;

    Voxel voxel;
    voxel.id = id.x + id.y * numPointsPerAxis + id.z * numPointsPerAxis * numPointsPerAxis;
    voxel.position = coordToWorld(id);
    voxels.Append(voxel);
}
