#pragma kernel CSMain

struct Modification
{
    float3 position;
    float before;
    float after;
};

RWTexture3D<float> points;
AppendStructuredBuffer<Modification> modifiedCells;
int textureSize;
int3 brushCenter;
int brushRadius;
float deltaTime;
float weight;

float3 coordToWorld(int3 coord)
{
    return coord - ((textureSize - 1.0) * 0.5f);
}


// return smooth value between 0 and 1 (0 when t = minVal, 1 when t = maxVal)
float smoothstep(float minVal, float maxVal, float t)
{
    t = saturate((t - minVal) / (maxVal - minVal));
    return t * t * (3 - 2 * t);
}

void setModification(uint3 id, float before, float after)
{
    Modification modification;
    modification.position = coordToWorld(id);
    modification.before = before;
    modification.after = after;
    modifiedCells.Append(modification);
}

[numthreads(8,8,8)]
void CSMain(int3 id : SV_DispatchThreadID)
{
    const int borderSize = 1;
    if (id.x >= textureSize - borderSize || id.y >= textureSize - borderSize || id.z >= textureSize - borderSize)
    {
        return;
    }
    if (id.x <= borderSize || id.y <= borderSize || id.z <= borderSize)
    {
        return;
    }

    int3 offset = id - brushCenter;
    int sqrDst = dot(offset, offset);

    if (sqrDst > brushRadius * brushRadius) return;
    float dst = sqrt(sqrDst);
    float brushWeight = 1 - smoothstep(brushRadius * 0.7, brushRadius, dst);
    float valueToApply = weight * deltaTime * brushWeight;
    float newValue = min(1, max(-1, points[id] + valueToApply));
    
    setModification(id, points[id], newValue);
    points[id] = newValue;
}
