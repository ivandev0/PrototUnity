#pragma kernel CSMain

RWTexture3D<float> points;
uint textureSize;
float radius;

float calculateDensity(int3 cell)
{
    float3 worldPos = cell / float(textureSize - 1.0) - 0.5f;

    float radiusD = radius / float(textureSize);
    float maxD = length(float3(radiusD, radiusD, radiusD));

    float density = length(worldPos) / maxD - 0.5f;

    return density;
}

static const int numThreads = 8;

[numthreads(numThreads, numThreads, numThreads)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= textureSize || id.y >= textureSize || id.z >= textureSize)
    {
        return;
    }

    points[id] = calculateDensity(id);
}
